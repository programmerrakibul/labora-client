# Base URL of the Labora REST API (without the /api suffix).
# The client appends /api automatically (e.g. http://localhost:8000/api).
VITE_API_BASE_URL=http://localhost:8000

# URL the browser is served from (dev server / deployed origin).
# Currently hardcoded for Google sign-in callback in
# src/features/auth/components/google-sign-in-button.jsx.
# VITE_APP_URL=http://localhost:3000

# Demo credentials used by the "Demo Job Seeker" / "Demo Recruiter" buttons
# on the login page. Fill in your seeded demo accounts.
DEMO_JOB_SEEKER_EMAIL=
DEMO_JOB_SEEKER_PASSWORD=
DEMO_RECRUITER_EMAIL=
DEMO_RECRUITER_PASSWORD=
